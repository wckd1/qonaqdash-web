{
  "name": "qonaqdash-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "lint": "eslint src/ e2e/ scripts/",
    "lint:fix": "eslint src/ e2e/ scripts/ --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.config.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.config.{ts,js}\"",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "contract:sync": "node scripts/contract.mjs sync",
    "contract:check": "node scripts/contract.mjs check"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "axios": "^1.21.1",
    "date-fns": "^4.4.0",
    "libphonenumber-js": "^1.13.16",
    "pinia": "^3.0.4",
    "vue": "^3.5.45",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "~1.64.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.0"
  }
}
