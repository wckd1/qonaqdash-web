{
  "name": "qonaqdash-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\""
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.7",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.1",
    "vue-tsc": "^2.2.0"
  }
}
